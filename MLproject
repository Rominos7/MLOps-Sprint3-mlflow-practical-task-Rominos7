name: mlflow-pipeline
python_env: python_env.yaml

entry_points:
  train:
    parameters:
      experiment_name: {type: str, default: "mlflow-pipeline"}
      model_type: {type: str, default: "rf"}
      params: {type: str, default: "{}"}
    command: "python -m src.train --experiment-name {experiment_name} --model-type {model_type} --params {params}"
  register:
    parameters:
      experiment_name: {type: str, default: "mlflow-pipeline"}
      metric: {type: str, default: "f1_score"}
    command: "python -m src.register_model --experiment-name {experiment_name} --metric {metric}"
  predict:
    parameters:
      model_name: {type: str, default: "MLflowModel"}
      alias: {type: str, default: "champion"}
      data_path: {type: str, default: ""}
      output: {type: str, default: "./predictions.csv"}
    command: "python -m src.predict --model-name {model_name} --alias {alias} --data-path {data_path} --output {output}"
  build_image:
    parameters:
      model_name: {type: str, default: "MLflowModel"}
      alias: {type: str, default: "champion"}
      image_name: {type: str, default: "mlflow-model:latest"}
    command: "python -m src.build_image --model-name {model_name} --alias {alias} --image-name {image_name}"
